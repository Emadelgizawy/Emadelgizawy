{
  "name": "kitchens-platform",
  "version": "1.0.0",
  "description": "منصة مطابخ الجيزاوي الحديثة",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "cd client && npm start",
    "dev:server": "cd server && npm run dev",
    "dev:admin": "cd admin && npm start",
    "build": "concurrently \"npm run build:client\" \"npm run build:server\" \"npm run build:admin\"",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "build:admin": "cd admin && npm run build",
    "test": "concurrently \"npm run test:client\" \"npm run test:server\""
  },
  "keywords": [
    "مطابخ",
    "تصميم",
    "ديكور",
    "furniture",
    "kitchen"
  ],
  "author": "مطابخ الجيزاوي",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
